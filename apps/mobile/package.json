{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "pnpm --filter @line-crm/shared build && pnpm --filter @line-crm/admin-client build && pnpm --filter @line-harness/sdk build && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@line-crm/admin-client": "workspace:*",
    "@line-crm/shared": "workspace:*",
    "@line-harness/sdk": "workspace:*",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.15",
    "eslint": "^9.28.0",
    "eslint-config-expo": "~57.0.2",
    "postcss": "^8.5.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.0"
  }
}
